{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest", "concurrency": 1, "coverageAnalysis": "perTest", "ignoreStatic": true,
  "mutator": { "excludedMutations": ["StringLiteral", "ObjectLiteral", "ArrayDeclaration", "ArrowFunction", "BlockStatement"] },
  "incremental": true, "incrementalFile": "reports/mutation/incremental-pages.json",
  "mutate": [
    "src/App.js", "src/index.js", "src/setupTests.js", "src/features/steps/index.js",
    "src/features/partnerBilling/stripeAction.js", "src/features/partnerProfile/logo.js",
    "src/pages/AdminDashboard.js", "src/pages/Auth.js", "src/pages/Landing.js", "src/pages/PartnerDashboard.js",
    "src/pages/PartnerLanding.js", "src/pages/PartnerPayment.js", "src/pages/UserDashboard.js"
  ],
  "reporters": ["clear-text", "progress", "html", "json"], "thresholds": { "high": 100, "low": 100, "break": 100 },
  "jest": { "projectType": "custom", "configFile": "jest.pages.config.js" }
}
