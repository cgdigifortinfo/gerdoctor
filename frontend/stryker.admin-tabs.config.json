{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest", "concurrency": 1, "coverageAnalysis": "perTest", "ignoreStatic": true,
  "mutator": { "excludedMutations": ["StringLiteral", "ObjectLiteral", "ArrayDeclaration", "ArrowFunction", "BlockStatement"] },
  "incremental": true, "incrementalFile": "reports/mutation/incremental-admin-tabs-adapters.json",
  "mutate": ["src/features/admin/tabs/*.js", "src/features/admin/adminTabViewModels.js"],
  "reporters": ["clear-text", "progress", "html", "json"], "thresholds": { "high": 100, "low": 100, "break": 100 },
  "jest": { "projectType": "custom", "configFile": "jest.admin-tabs.config.js" }
}
