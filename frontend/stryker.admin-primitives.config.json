{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest", "concurrency": 1, "coverageAnalysis": "perTest", "ignoreStatic": true,
  "mutator": { "excludedMutations": ["StringLiteral", "ObjectLiteral", "ArrayDeclaration", "ArrowFunction", "BlockStatement"] },
  "incremental": true, "incrementalFile": "reports/mutation/incremental-admin-primitives.json",
  "mutate": [
    "src/features/admin/AdminDashboardComponents/AdminCmsSections.js",
    "src/features/admin/AdminDashboardComponents/AdminPrimitives.js",
    "src/features/admin/adminPrimitiveDomain.js"
  ],
  "reporters": ["clear-text", "progress", "html", "json"], "thresholds": { "high": 100, "low": 100, "break": 100 },
  "jest": { "projectType": "custom", "configFile": "jest.admin-primitives.config.js" }
}
