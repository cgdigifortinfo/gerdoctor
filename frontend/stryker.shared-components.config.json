{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest", "concurrency": 1, "coverageAnalysis": "perTest", "ignoreStatic": true,
  "mutator": { "excludedMutations": ["StringLiteral", "ObjectLiteral", "ArrayDeclaration", "ArrowFunction", "BlockStatement"] },
  "incremental": true, "incrementalFile": "reports/mutation/incremental-shared-components-domains.json",
  "mutate": [
    "src/components/ConfirmDialog.jsx", "src/components/JourneyProgressIndicator.js", "src/components/Logo.js",
    "src/components/PaginationControls.js", "src/components/paginationDomain.js", "src/components/ProtectedRoute.js", "src/components/routeDomain.js", "src/components/ThemeLangToggle.js",
    "src/components/collections/*.{js,jsx}", "src/components/layout/*.{js,jsx}"
  ],
  "reporters": ["clear-text", "progress", "html", "json"], "thresholds": { "high": 100, "low": 100, "break": 100 },
  "jest": { "projectType": "custom", "configFile": "jest.shared-components.config.js" }
}
