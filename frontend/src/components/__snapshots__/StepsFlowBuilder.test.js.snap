          </button>
          <button
            class="bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white"
            data-testid="condition-confirm-btn"
          >
            Speichern
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
`;

exports[`default wrapper composes the flow provider and empty editor controls: empty flow builder 1`] = `
