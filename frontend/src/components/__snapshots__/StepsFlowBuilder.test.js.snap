            data-options="[{\\"value\\":\\"pending\\",\\"label\\":\\"Ausstehend\\"},{\\"value\\":\\"in_progress\\",\\"label\\":\\"In Bearbeitung\\"},{\\"value\\":\\"completed\\",\\"label\\":\\"Abgeschlossen\\"},{\\"value\\":\\"rejected\\",\\"label\\":\\"Abgelehnt\\"}]"
            data-placeholder="Mehrere Werte auswählen"
            data-search-placeholder="Werte durchsuchen oder eingeben …"
            data-testid="condition-value-input"
            data-values="[]"
          >
            multi
          </button>
        </div>
      </div>
      <div
        class="flex gap-2 justify-between mt-5"
      >
        <div>
          <button
            class="border-red-200 text-red-600 hover:bg-red-50"
            data-testid="condition-delete-btn"
            variant="outline"
          >
            <i />
             Löschen
          </button>
        </div>
        <div
          class="flex gap-2"
        >
          <button
            data-testid="condition-cancel-btn"
            variant="outline"
          >
            Abbrechen
          </button>
          <button
            class="bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white"
            data-testid="condition-confirm-btn"
          >
            Speichern
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
`;

exports[`condition modal handles hidden state, field/operator shapes, create, edit, cancel and delete: upload condition modal 1`] = `
<div>
  <div
    class="fixed inset-0 z-[70] flex items-center justify-center bg-black/50"
  >
    <div
      class="mx-4 w-full max-w-xl rounded-xl border border-border bg-card p-6 shadow-xl"
      data-testid="condition-modal"
    >
      <h3
        class="text-lg font-semibold text-foreground mb-1"
      >
        Regel bearbeiten
      </h3>
      <p
        class="text-xs text-muted-foreground mb-4"
      >
        Von 
        <span
          class="font-semibold"
        >
          #
          1
           
          source
        </span>
         → auf 
        <span
          class="font-semibold"
        >
          #
          2
           
          target
        </span>
      </p>
      <div
        class="space-y-3"
      >
        <div>
          <label
            class="text-xs font-medium text-foreground"
          >
            Aktion
          </label>
          <select
            class="w-full mt-1 px-2 py-1.5 text-sm bg-background border border-border rounded-sm"
            data-testid="condition-action-select"
          >
            <option
              value="hide"
            >
              Ausblenden
            </option>
            <option
              value="block"
            >
              Blockieren
            </option>
            <option
              value="auto_complete"
            >
              Auto-Abschließen
            </option>
            <option
              value="read_only"
            >
              Schreibschützen
            </option>
            <option
              value="allow_next"
            >
              Weiter erlauben
            </option>
            <option
              value="redirect"
            >
              Weiterleiten
            </option>
          </select>
        </div>
        <div
          class="grid gap-3 sm:grid-cols-2"
        >
          <div>
            <label
              class="text-xs font-medium text-foreground"
            >
              Status oder Feld
            </label>
            <button
              data-options="[{\\"value\\":\\"status\\",\\"label\\":\\"Schrittstatus\\",\\"description\\":\\"Systemfeld\\"},{\\"value\\":\\"upload\\",\\"label\\":\\"upload\\",\\"description\\":\\"upload · multiupload\\"},{\\"value\\":\\"choice\\",\\"label\\":\\"Choice\\",\\"description\\":\\"choice · selectbox\\"}]"
              data-placeholder="Feld auswählen"
              data-search-placeholder="Feld durchsuchen …"
              data-testid="condition-field-input"
            >
              select:
              upload
            </button>
          </div>
          <div>
            <label
              class="text-xs font-medium text-foreground"
            >
              Operator
            </label>
            <select
              class="w-full mt-1 min-h-10 px-2 py-1.5 text-sm bg-background border border-border rounded-md"
              data-testid="condition-operator-select"
            >
              <option
                value="equals"
              >
                gleich
              </option>
              <option
                value="not_equals"
              >
                ungleich
              </option>
              <option
                value="one_of"
              >
                ist einer von
              </option>
              <option
                value="not_one_of"
              >
                ist keiner von
              </option>
              <option
                value="contains"
              >
                enthält
              </option>
              <option
                value="not_empty"
              >
                nicht leer
              </option>
              <option
                value="empty"
              >
                leer
              </option>
              <option
                value="status_is"
              >
                Status ist
              </option>
              <option
                value="status_not"
              >
                Status ungleich
              </option>
              <option
                value="has_upload"
              >
                Dokument vorhanden
              </option>
              <option
                value="missing_upload"
              >
                Dokument fehlt
              </option>
            </select>
          </div>
        </div>
        <div>
          <label
            class="text-xs font-medium text-foreground"
          >
            Wert
          </label>
          <button
            data-options="[{\\"value\\":\\"Passport\\",\\"label\\":\\"Passport\\"}]"
            data-placeholder="Wert auswählen"
            data-search-placeholder="Wert durchsuchen …"
            data-testid="condition-value-input"
          >
            select:
            Passport
          </button>
        </div>
      </div>
      <div
        class="flex gap-2 justify-between mt-5"
      >
        <div>
          <button
            class="border-red-200 text-red-600 hover:bg-red-50"
            data-testid="condition-delete-btn"
            variant="outline"
          >
            <i />
             Löschen
          </button>
        </div>
        <div
          class="flex gap-2"
        >
          <button
            data-testid="condition-cancel-btn"
            variant="outline"
          >
