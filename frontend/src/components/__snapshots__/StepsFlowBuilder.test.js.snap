          variant="outline"
        >
          <i />
           Abspielen
        </button>
      </div>
      <div
        class="flow-legend absolute top-3 right-3 z-10 flex flex-wrap gap-2 max-w-[60%] justify-end pointer-events-none"
      >
        <span
          class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] bg-white dark:bg-slate-800 border border-border rounded-sm shadow-sm"
        >
          <span
            class="w-3 h-[1.5px]"
            style="background: rgb(148, 163, 184);"
          />
          Ausblenden
        </span>
        <span
          class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] bg-white dark:bg-slate-800 border border-border rounded-sm shadow-sm"
        >
          <span
            class="w-3 h-[1.5px]"
            style="background: rgb(220, 38, 38);"
          />
          Blockieren
        </span>
        <span
          class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] bg-white dark:bg-slate-800 border border-border rounded-sm shadow-sm"
        >
          <span
            class="w-3 h-[1.5px]"
            style="background: rgb(5, 150, 105);"
          />
          Auto-Abschluss
        </span>
        <span
          class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] bg-white dark:bg-slate-800 border border-border rounded-sm shadow-sm"
        >
          <span
            class="w-3 h-[1.5px]"
          />
          Weiter
        </span>
        <span
          class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] bg-white dark:bg-slate-800 border border-border rounded-sm shadow-sm"
        >
          <span
            class="w-3 h-[1.5px]"
            style="background: rgb(37, 99, 235);"
          />
          Weiterleiten
        </span>
        <span
          class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] bg-violet-100 text-violet-800 dark:bg-violet-950/50 dark:text-violet-200 border border-violet-200 dark:border-violet-800 rounded-sm shadow-sm"
        >
          <i />
           Schreibschutz am Step
        </span>
      </div>
      <div
        class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none"
        data-testid="flow-empty-state"
      >
        <div
          class="pointer-events-auto bg-card border border-border rounded-sm shadow-sm p-5 text-center max-w-sm"
        >
          <p
            class="text-sm font-semibold text-foreground"
          >
            Keine Steps in diesem Survey
          </p>
          <p
            class="text-xs text-muted-foreground mt-1"
          >
            Erstelle den ersten Step oder ziehe einen Step-Typ auf den Canvas.
          </p>
          <button
            class="mt-4 bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white"
            data-testid="flow-empty-add-step-btn"
          >
            <i />
             Step erstellen
          </button>
        </div>
      </div>
      <div
        data-testid="react-flow"
      >
        <i />
        <i
          data-props="{\\"showInteractive\\":false}"
          data-testid="controls"
        />
        <button
          data-fallback-color="#94a3b8"
          data-form-color="var(--brand-primary)"
          data-props="{\\"pannable\\":true,\\"zoomable\\":true}"
          data-testid="minimap"
        />
      </div>
    </div>
  </div>
</div>
`;

