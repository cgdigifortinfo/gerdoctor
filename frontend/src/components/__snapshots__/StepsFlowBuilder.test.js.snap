          style="border-left-width: 3px; border-left-color: #64748b;"
        >
          <span
            class="w-2 h-2 rounded-sm flex-shrink-0"
            style="background: rgb(100, 116, 139);"
          />
          <span
            class="truncate"
          >
            Info
          </span>
        </div>
      </div>
    </div>
    <div
      class="flex-1 relative"
    >
      <div
        class="absolute top-3 left-3 z-10 flex gap-2 flex-wrap items-center"
      >
        <button
          class="bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white shadow"
          data-testid="flow-add-step-btn"
        >
          <i />
           Step
        </button>
        <button
          class="bg-card border-border shadow"
          data-testid="flow-auto-layout-btn"
          variant="outline"
        >
          <i />
           
          Auto-Layout
        </button>
        <button
          class="bg-card border-border shadow"
          data-testid="flow-fullscreen-btn"
          title="Vollbild"
          variant="outline"
        >
          <i />
          Vollbild
        </button>
        <div
          class="inline-flex rounded-sm shadow bg-card border border-border overflow-hidden"
        >
          <button
            class="px-2 py-1.5 text-xs text-foreground hover:bg-muted disabled:opacity-40 disabled:cursor-not-allowed border-r border-border flex items-center gap-1"
            data-testid="flow-undo-btn"
            title="Rückgängig (Strg+Z)"
            type="button"
          >
            <i />
             Undo
          </button>
          <button
            class="px-2 py-1.5 text-xs text-foreground hover:bg-muted disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1"
            data-testid="flow-redo-btn"
            title="Wiederherstellen (Strg+Shift+Z)"
            type="button"
          >
            <i />
             Redo
          </button>
        </div>
        <button
          data-testid="simulator"
        >
          simulator
        </button>
        <button
          class="shadow bg-card border-border"
          data-testid="flow-playback-btn"
          title="Animierten Durchlauf starten"
          variant="outline"
        >
          <i />
           Abspielen
        </button>
      </div>
      <div
        class="flow-legend absolute top-3 right-3 z-10 flex flex-wrap gap-2 max-w-[60%] justify-end pointer-events-none"
      >
        <span
          class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] bg-white dark:bg-slate-800 border border-border rounded-sm shadow-sm"
        >
          <span
            class="w-3 h-[1.5px]"
            style="background: rgb(148, 163, 184);"
          />
          Ausblenden
        </span>
        <span
          class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] bg-white dark:bg-slate-800 border border-border rounded-sm shadow-sm"
        >
          <span
            class="w-3 h-[1.5px]"
            style="background: rgb(220, 38, 38);"
          />
          Blockieren
        </span>
        <span
          class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] bg-white dark:bg-slate-800 border border-border rounded-sm shadow-sm"
        >
          <span
            class="w-3 h-[1.5px]"
            style="background: rgb(5, 150, 105);"
          />
          Auto-Abschluss
        </span>
        <span
          class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] bg-white dark:bg-slate-800 border border-border rounded-sm shadow-sm"
        >
          <span
            class="w-3 h-[1.5px]"
          />
          Weiter
        </span>
        <span
          class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] bg-white dark:bg-slate-800 border border-border rounded-sm shadow-sm"
        >
          <span
            class="w-3 h-[1.5px]"
            style="background: rgb(37, 99, 235);"
          />
          Weiterleiten
        </span>
        <span
          class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] bg-violet-100 text-violet-800 dark:bg-violet-950/50 dark:text-violet-200 border border-violet-200 dark:border-violet-800 rounded-sm shadow-sm"
        >
          <i />
           Schreibschutz am Step
        </span>
      </div>
      <div
        data-testid="react-flow"
      >
        <i />
        <i
          data-props="{\\"showInteractive\\":false}"
          data-testid="controls"
        />
        <button
          data-fallback-color="#94a3b8"
          data-form-color="var(--brand-primary)"
          data-props="{\\"pannable\\":true,\\"zoomable\\":true}"
          data-testid="minimap"
        />
      </div>
    </div>
  </div>
</div>
`;

