{
  "name": "gerdoctor-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-checkbox": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.9",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "lucide-react": "^0.507.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.1",
    "react-scripts": "5.0.1",
    "react-simple-wysiwyg": "^3.4.1",
    "reactflow": "^11.11.4",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "test": "craco test",
    "test:unit": "craco test --watchAll=false",
    "test:coverage": "craco test --watchAll=false --coverage",
    "test:mutation": "node scripts/run-mutation-shards.cjs",
    "test:mutation:manifest": "node scripts/check-mutation-shards.cjs",
    "test:mutation:domains": "stryker run stryker.domains.config.json",
    "test:mutation:normalization": "stryker run stryker.normalization.config.json",
    "test:mutation:builders": "stryker run stryker.builders.config.json",
    "test:mutation:step-core": "stryker run stryker.step-core.config.json",
    "test:mutation:flow-builder": "stryker run stryker.flow-builder.config.json",
    "test:mutation:step-domains": "stryker run stryker.step-domains.config.json",
    "test:mutation:step-controller": "stryker run stryker.step-controller.config.json",
    "test:mutation:step-panels": "stryker run stryker.step-panels.config.json",
    "test:mutation:admin-hooks": "stryker run stryker.admin-hooks.config.json",
    "test:mutation:admin-tabs": "stryker run stryker.admin-tabs.config.json",
    "test:mutation:pages": "stryker run stryker.pages.config.json",
    "test:mutation:infrastructure": "stryker run stryker.infrastructure.config.json",
    "test:mutation:shared": "stryker run stryker.shared-components.config.json",
    "test:mutation:ui": "stryker run stryker.ui-primitives.config.json"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@craco/craco": "^7.1.0",
    "@stryker-mutator/core": "9.3.0",
    "@stryker-mutator/jest-runner": "9.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  }
}
