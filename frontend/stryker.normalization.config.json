{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "concurrency": 2,
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "mutator": {
    "excludedMutations": ["StringLiteral", "ObjectLiteral", "ArrayDeclaration", "ArrowFunction", "BlockStatement"]
  },
  "incremental": true,
  "incrementalFile": "reports/mutation/incremental-normalization.json",
  "mutate": [
    "src/lib/valueNormalization.js",
    "src/features/admin/emailTemplateDomain.js",
    "src/components/admin/EmailTemplateEditor.js"
  ],
  "reporters": ["clear-text", "progress", "html", "json"],
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "jest": { "projectType": "create-react-app" }
}
