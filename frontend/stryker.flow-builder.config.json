{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "concurrency": 2,
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "mutator": {
    "excludedMutations": ["StringLiteral", "ObjectLiteral", "ArrayDeclaration", "ArrowFunction", "BlockStatement"]
  },
  "incremental": true,
  "incrementalFile": "reports/mutation/incremental-flow-builder-final.json",
  "mutate": ["src/components/StepsFlowBuilder.js"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "jest": { "projectType": "custom", "configFile": "jest.flow-builder.config.js" }
}
